# Скопировать в .env и заполнить своими значениями.
# .env в git не попадает (см. .gitignore).

# Токены дневника Киасуо. Access живёт час, refresh обновляет его сам
# и перезаписывает обе строки в .env, поэтому файл должен быть доступен
# на запись. Первый вход — из браузера (см. README в AGENTS.md).
ACCESS_TOKEN=
REFRESH_TOKEN=

# PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dnevnik

# Telegram-бот
BOT_API_KEY=

# Прокси до Bot API — нужен, если провайдер режет Telegram (в РФ это норма).
# Формат: socks5://user:password@host:port или http://host:port.
# Пусто — подключаемся напрямую.
BOT_PROXY=

# Адрес Bot API, если api.telegram.org недоступен вообще (Cloudflare Worker,
# свой реверс-прокси). Пример: https://tg-proxy.ник.workers.dev
# Запросы идут на этот адрес, а он уже ходит в Telegram. Пусто — напрямую.
BOT_API_BASE=

# id дневника в Киасуо (число из URL дневника: /diary/api/schedule?id=<это>)
DIARY_ID=

# ИИ: основная модель (разбор ДЗ и решение) и бесплатная для поиска страниц
AI_PROVIDER=routerai
AI_MODEL=z-ai/glm-5.3-flash
AI_REASONING_EFFORT=medium
AI_TEMPERATURE=0
AI_SEARCH_PROVIDER=gigachat

# Распознавание страниц параграфа для пересказа.
# routerai — платно (~0.077 ₽ за страницу), зато 4 страницы параллельно;
# gigachat — бесплатно, но у free-тарифа всего 1 запрос одновременно
# (~10 с на страницу), поэтому параллельность там не работает.
OCR_PROVIDER=routerai
# Модель OCR. Пусто — AI_MODEL для routerai (быстрее всех: ~3 с на страницу)
# и GigaChat-3-Ultra для gigachat.
# Дешевле вдвое, но в 3–4 раза медленнее и иногда в таймаут:
# OCR_MODEL=nex-agi/nex-n2.5-mini
OCR_MODEL=
# Сколько страниц распознавать одновременно (для gigachat смысла больше 1 нет).
OCR_CONCURRENCY=4

ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# GigaChat (OAuth-ключ из личного кабинета)
GIGACHAT_API_KEY=

# Логи: уровень (DEBUG/INFO/WARNING/ERROR) и, при необходимости, свой файл.
# По умолчанию INFO и logs/<процесс>.log (bot.log, worker.log).
LOG_LEVEL=INFO
