# Скопировать в .env и заполнить своими значениями.
# .env в git не попадает (см. .gitignore).

# Токены дневника Киасуо. Access живёт час, refresh обновляет его сам
# и перезаписывает обе строки в .env, поэтому файл должен быть доступен
# на запись. Первый вход — из браузера (см. README в AGENTS.md).
ACCESS_TOKEN=
REFRESH_TOKEN=

# PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dnevnik

# Telegram-бот
BOT_API_KEY=

# id дневника в Киасуо (число из URL дневника: /diary/api/schedule?id=<это>)
DIARY_ID=

# ИИ: основная модель (разбор ДЗ и решение) и бесплатная для поиска страниц
AI_PROVIDER=routerai
AI_MODEL=z-ai/glm-5.3-flash
AI_REASONING_EFFORT=medium
AI_TEMPERATURE=0
AI_SEARCH_PROVIDER=gigachat

ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# GigaChat (OAuth-ключ из личного кабинета)
GIGACHAT_API_KEY=

# Логи: уровень (DEBUG/INFO/WARNING/ERROR) и, при необходимости, свой файл.
# По умолчанию INFO и logs/<процесс>.log (bot.log, worker.log).
LOG_LEVEL=INFO
